<?xml version="1.0" encoding="utf-8"?>
<!-- The DoseBook mark: an open book with a capsule above it. Drawn inside the centre two thirds
     of a 108 x 108 grid, the part an adaptive icon never crops.
     Same geometry as mobile/lib/widgets/logo.dart and the logo in the Figma file. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="50"
        android:scaleX="0.88"
        android:scaleY="0.88"
        android:translateY="4">
        <path
            android:fillColor="#FFFFFF"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3"
            android:strokeLineJoin="round"
            android:pathData="M30,44 L52,50 L52,80 L30,74 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3"
            android:strokeLineJoin="round"
            android:pathData="M78,44 L56,50 L56,80 L78,74 Z" />
        <group
            android:rotation="-35"
            android:translateX="54"
            android:translateY="31">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M0,-5.5 H-7.5 A5.5,5.5 0 0 0 -7.5,5.5 H0 Z" />
            <path
                android:fillColor="@color/brand_light"
                android:pathData="M0,-5.5 H7.5 A5.5,5.5 0 0 1 7.5,5.5 H0 Z" />
        </group>
    </group>
</vector>

  "info": {
    "title": "DoseBook API",
    "description": "Recall and remind. The API never prescribes: it only returns what the user confirmed or noted.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AcknowledgeDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "version"
        ]
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "object",
            "nullable": true
          },
          "dateOfBirth": {
            "type": "object",
            "nullable": true,
            "example": "1990-05-17"
          },
          "sex": {
            "type": "string",
            "nullable": true,
            "enum": [
              "FEMALE",
              "MALE",
              "OTHER"
            ]
          },
          "heightCm": {
            "type": "object",
            "nullable": true,
            "minimum": 30,
            "maximum": 272,
            "description": "Centimetres"
          },
          "weightKg": {
            "type": "object",
            "nullable": true,
            "minimum": 1,
            "maximum": 500,
            "description": "Kilograms"
          },
          "bloodGroup": {
            "type": "string",
            "nullable": true,
            "enum": [
              "A+",
              "A-",
              "B+",
              "B-",
              "AB+",
              "AB-",
              "O+",
              "O-"
            ]
          },
          "emergencyName": {
            "type": "object",
            "nullable": true
          },
          "emergencyPhone": {
            "type": "object",
            "nullable": true
          },
          "conditions": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "CredentialsDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "demo.patient@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "DoctorDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Dr. A. Mehra"
          },
          "phone": {
            "type": "string",
            "example": "+91 00000 00101"
          },
          "registrationNo": {
            "type": "string"
          },
          "specialty": {
            "type": "string"
          },
          "availability": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "ScheduleDto": {
        "type": "object",
        "properties": {
          "slots": {
            "type": "array",
            "example": [
              "MORNING",
              "NOON",
              "NIGHT"
            ],
            "items": {
              "type": "string",
              "enum": [
                "MORNING",
                "NOON",
                "EVENING",
                "NIGHT"
              ]
            }
          },
          "food": {
            "type": "string",
            "enum": [
              "BEFORE_FOOD",
              "AFTER_FOOD"
            ]
          },
          "dosesPerDay": {
            "type": "number",
            "minimum": 1,
            "maximum": 4
          },
          "courseDays": {
            "type": "number",
            "minimum": 1,
            "maximum": 365
          },
          "startDate": {
            "type": "string",
            "example": "2026-10-04",
            "description": "First day of the course in the user's local date. Defaults to today (UTC)."
          }
        },
        "required": [
          "slots",
          "food",
          "dosesPerDay",
          "courseDays"
        ]
      },
      "ConfirmMedicineDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Paracetamol"
          },
          "dose": {
            "type": "string",
            "example": "500 mg, 1 tablet"
          },
          "frequency": {
            "type": "string",
            "example": "3 times a day"
          },
          "duration": {
            "type": "string",
            "example": "5 days"
          },
          "schedule": {
            "$ref": "#/components/schemas/ScheduleDto"
          }
        },
        "required": [
          "name",
          "dose",
          "schedule"
        ]
      },
      "ConfirmDto": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "example": "Sore throat"
          },
          "date": {
            "type": "string",
            "example": "2026-03-12"
          },
          "doctor": {
            "$ref": "#/components/schemas/DoctorDto"
          },
          "sameDoctorId": {
            "type": "string",
            "description": "Answer to \"Same doctor?\": link to this existing card."
          },
          "newDoctor": {
            "type": "boolean",
            "description": "Answer to \"Same doctor?\": create a new card even though a name matches."
          },
          "medicines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConfirmMedicineDto"
            }
          }
        },
        "required": [
          "condition",
          "date",
          "doctor",
          "medicines"
        ]
      },
      "FeedbackDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "enum": [
              "WORKED",
              "DID_NOT_WORK",
              "SIDE_EFFECT"
            ],
            "nullable": true,
            "description": "null clears the feedback"
          }
        },
        "required": [
          "value"
        ]
      },
      "StopDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "The user's local date. Defaults to today (UTC)."
          }
        }
      },
      "AllergyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Penicillin"
          }
        },
        "required": [
          "name"
        ]
      },
      "MarkDoseDto": {
        "type": "object",
        "properties": {
          "medicineId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "example": "2026-10-04"
          },
          "slot": {
            "type": "string",
            "example": "MORNING",
            "description": "Slot name, or HH:mm for an own reminder"
          },
          "status": {
            "type": "string",
            "enum": [
              "TAKEN",
              "SKIPPED"
            ]
          }
        },
        "required": [
          "medicineId",
          "date",
          "slot",
          "status"
        ]
      },
      "NoteDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "example": "Ask Dr. Mehra about the cough at the next visit."
          }
        },
        "required": [
          "text"
        ]
      },
      "CreateOwnReminderDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Vitamin D3"
          },
          "dose": {
            "type": "string",
            "example": "1 capsule"
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "MORNING",
                "NOON",
                "EVENING",
                "NIGHT"
              ]
            }
          },
          "times": {
            "example": [
              "08:00"
            ],
            "description": "Clock times as HH:mm",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startDate": {
            "type": "string",
            "description": "The user's local date. Defaults to today (UTC)."
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateOwnReminderDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Vitamin D3"
          },
          "dose": {
            "type": "string",
            "example": "1 capsule"
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "MORNING",
                "NOON",
                "EVENING",
                "NIGHT"
              ]
            }
          },
          "times": {
            "example": [
              "08:00"
            ],
            "description": "Clock times as HH:mm",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startDate": {
            "type": "string",
            "description": "The user's local date. Defaults to today (UTC)."
          }
        }
      },
      "ChatDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "I have a sore throat"
          }
        },
        "required": [
          "message"
        ]
      },
      "UpdateDoctorDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "object",
            "nullable": true
          },
          "registrationNo": {
            "type": "object",
            "nullable": true
          },
          "specialty": {
            "type": "object",
            "nullable": true
          },
          "availability": {
            "type": "object",
            "nullable": true
          }
        }
      }
    }
  }
}

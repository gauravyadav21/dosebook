# Names only. Copy to .env and fill locally. Never commit .env.
# Local database from scripts/dev-db.sh: postgresql://app@localhost:54329/dosebook_app
DATABASE_URL=
# Long random value used to sign session tokens, for example: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=3000
UPLOAD_DIR=./uploads
# Requests per minute per client: whole API, sign-in routes, chat.
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
CHAT_THROTTLE_LIMIT=30
# Optional. With a key, prescriptions are read by Gemini (free tier: fake prescriptions only)
# and chat can fetch general medicine information once per medicine and save it.
# Without one, the built-in demo reader and manual entry are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Used when the first model is retired, over its free quota or overloaded.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
